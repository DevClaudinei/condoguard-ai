APP_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:condopassword123@localhost:5432/condoguard_db
SECRET_KEY=sua_chave_secreta_aqui
WHATSAPP_API_URL=https://api.provedor.com/v1/send
WHATSAPP_API_KEY=coloque_sua_chave_aqui
SINDICO_PHONE=5547999999999
SUBSINDICO_PHONE=5547888888888

# Deduplicação semântica
DEDUP_JANELA_HORAS=4
DEDUP_LIMIAR_COSSENO=0.35

# Mensageria de alertas P1 (AWS). Deixe SNS_TOPIC_P1_ARN vazio para usar log local.
AWS_REGION=us-east-1
SNS_TOPIC_P1_ARN=

# Autenticação JWT (gestão/síndico). Troque JWT_SECRET_KEY em produção!
JWT_SECRET_KEY=troque-por-um-segredo-forte-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=sindico
ADMIN_PASSWORD=defina_uma_senha_forte

# CORS por ambiente (origens separadas por vírgula, sem wildcard em produção)
CORS_ORIGINS=http://localhost:4200

# Rate-limiting do endpoint de triagem (formato slowapi/limits)
RATE_LIMIT_TRIAGEM=10/minute
